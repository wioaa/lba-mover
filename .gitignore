__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# build.py --dist 的备用产物目录（程序正开着时用它出包，避免覆盖被占用的 exe）
dist-*/
.eggs/

# 打包生成物
packaging/version_info.txt

# 本地临时产物（截图、断点、测试用状态目录）
.tmp/

# testflow 运行产物
.testflow/
.pytest_cache/

# 运行时产物：断点、日志、暂存
*.log
logs/
scratch/
*.stage
*.checkpoint.json

# 本地镜像/测试用磁盘文件
*.img
*.bin.disk

# 编辑器
.vscode/
.idea/

# 断点与流水（默认写在仓库内，见 engine/checkpoint.py）
.lbamover/

# 项目记忆：含本机绝对路径，不入公开仓库
.workbuddy/
